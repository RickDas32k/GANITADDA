# ==============================================================================
# GANIT ADDA - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real secret credentials to version control.

# 1. Database (Supabase PostgreSQL / Neon Serverless)
# Option A - Supabase (Recommended for Vercel: use Transaction Pooler on port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"
# Option B - Supabase Direct Connection (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
# Option C - Neon Serverless PostgreSQL:
DATABASE_URL="postgresql://neondb_owner:PASSWORD@HOST.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication & Sessions (Minimum 32 random characters)
SESSION_SECRET="generate-a-strong-32-character-random-secret-string-here"
JWT_SECRET="generate-another-strong-32-character-random-secret-here"

# 3. Super Administrator Credentials
ADMIN_EMAIL="admin@ganitadda.in"
# Generate with: npm run admin:hash -- 'YourStrongPassword123!'
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_BCRYPT_HASH"

# 4. Storage (Vercel Blob / S3 / Cloudflare R2)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# 5. Payment Gateway Configuration (Indian Payments - Razorpay / PayU)
PAYMENT_PROVIDER="RAZORPAY"
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# PayU Credentials (if using PayU instead of Razorpay)
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""

# 6. Transactional Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="GANIT ADDA <orders@ganitadda.in>"

# 7. Public Application Information
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="GANIT ADDA"
NEXT_PUBLIC_APP_TAGLINE="Maths Made Simple, One Step at a Time."
NEXT_PUBLIC_SUPPORT_PHONE="9874169625"
NEXT_PUBLIC_SUPPORT_EMAIL="madeeasyganit@gmail.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="919874169625"
